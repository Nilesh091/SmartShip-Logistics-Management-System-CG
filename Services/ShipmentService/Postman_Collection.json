{
  "info": {
    "_postman_id": "shipment-service-collection",
    "name": "ShipmentService API",
    "description": "Collection for testing ShipmentService endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customer - Create Shipment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sender\": {\n    \"name\": \"John Doe\",\n    \"street\": \"123 Main Street\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"zipCode\": \"10001\"\n  },\n  \"receiver\": {\n    \"name\": \"Jane Smith\",\n    \"street\": \"456 Oak Avenue\",\n    \"city\": \"Los Angeles\",\n    \"state\": \"CA\",\n    \"zipCode\": \"90001\"\n  },\n  \"package\": {\n    \"weight\": 5.5,\n    \"description\": \"Electronics package\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/shipments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "shipments"
          ]
        }
      }
    },
    {
      "name": "Customer - Get My Shipments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/shipments/my",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "shipments",
            "my"
          ]
        }
      }
    },
    {
      "name": "Customer - Get Shipment Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/shipments/{{shipment_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "shipments",
            "{{shipment_id}}"
          ]
        }
      }
    },
    {
      "name": "Customer - Book Shipment",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/shipments/{{shipment_id}}/book",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "shipments",
            "{{shipment_id}}",
            "book"
          ]
        }
      }
    },
    {
      "name": "Customer - Cancel Shipment",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/shipments/{{shipment_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "shipments",
            "{{shipment_id}}"
          ]
        }
      }
    },
    {
      "name": "Admin - Get All Shipments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_jwt_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/shipments/admin/all",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "shipments",
            "admin",
            "all"
          ]
        }
      }
    },
    {
      "name": "Admin - Update Shipment Status",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_jwt_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_TRANSIT\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/shipments/{{shipment_id}}/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "shipments",
            "{{shipment_id}}",
            "status"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:7182",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your-customer-jwt-token-here",
      "type": "string"
    },
    {
      "key": "admin_jwt_token",
      "value": "your-admin-jwt-token-here",
      "type": "string"
    },
    {
      "key": "shipment_id",
      "value": "your-shipment-id-here",
      "type": "string"
    }
  ]
}
