      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5045 }
      ],
      "UpstreamPathTemplate": "/api/auth/oauth/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "SwaggerKey": "auth"
    },

    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5045 }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
       "SwaggerKey": "auth"
    },


    {
      "DownstreamPathTemplate": "/api/Admin/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5127 }
      ],
      "UpstreamPathTemplate": "/admin/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "SwaggerKey": "admin"

    },


    {
      "DownstreamPathTemplate": "/api/Tracking/{everything}",
      "DownstreamScheme": "http",
