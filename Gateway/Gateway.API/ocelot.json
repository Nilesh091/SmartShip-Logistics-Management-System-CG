      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },  
      "SwaggerKey": "tracking"
    },


    {
      "DownstreamPathTemplate": "/api/shipments/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "localhost", "Port": 5286 }
      ],
      "UpstreamPathTemplate": "/shipments/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "SwaggerKey": "shipment"
    }
  ],
"SwaggerEndPoints": [
  {
    "Key": "auth",
    "Config": [
      {
        "Name": "Auth Service",
        "Version": "v1",
